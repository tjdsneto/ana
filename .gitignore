# deps
node_modules/
**/node_modules/

# build output
dist/
build/
*.tsbuildinfo
# but the "build" node type is source, not build output
!engine/types/build/

# runtime state — produced artifacts on the shared volume (Postgres data lives in the db container volume)
server/data/artifacts/

# postgres data (if a local bind-mount is ever used)
server/data/pgdata/

# engine's Claude Code state — session transcripts + cached creds (bind-mounted from engine-worker)
engine/data/

# secrets
.env
.env.local
# per-service container env files (real files gitignored; the .*_env.example are committed)
/*_env
!/*_env.example

# logs / os
*.log
.DS_Store

# overnight scratch (briefs, logs, captures) — not committed
tmp/

# host craft tools (playwright browsers / node_modules — not committed)
craft/video-production/tools/node_modules/

# Python bytecode
__pycache__/
*.pyc
