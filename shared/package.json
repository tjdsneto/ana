{
	"name": "@core/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Shared contract: domain types + port interfaces + Drizzle schema + migrations. Imported by server/mcp, server/engine, dashboard/api.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"migrate": "tsx src/migrate.ts",
		"seed": "tsx src/seed.ts",
		"db:generate": "drizzle-kit generate",
		"test": "vitest run"
	},
	"dependencies": {
		"drizzle-orm": "^0.38.2",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/pg": "^8.11.10",
		"drizzle-kit": "^0.30.1"
	}
}
