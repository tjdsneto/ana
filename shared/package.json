{
	"name": "@core/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Shared contract (@core/shared): domain types + port interfaces + Drizzle schema + migrations + test fakes. Imported by core/services, engine, server/mcp, server/api.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"migrate": "tsx src/migrate.ts",
		"seed": "tsx src/seed.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/pg": "^8.15.5"
	}
}
