# engine-worker CONTAINER env (the heavy knob set). Copy to .engine_env (gitignored) and edit. Every
# var is OPTIONAL — omit a line to use the code/image default. env_file does NOT shadow the image ENV
# for keys it omits, so RENDER_FONT and VOICE_MODEL are deliberately left out: the engine image bakes
# them (DejaVuSans + en_US-amy-medium). Set them only to override a baked path.

# Loop knobs (code defaults in engine/src/config.ts: poll 3000ms, redos 3, agreement caps 5/2).
# POLL_INTERVAL_MS=3000
# MAX_REDOS=3                  # rubric gate: redos before escalate
# AGREEMENT_MAX_ROUNDS_HUMAN=5 # briefing agreement loop, actor_kind=human
# AGREEMENT_MAX_ROUNDS_AGENT=2 # briefing agreement loop, actor_kind=agent

# Self-heal: claim lease + reaper (0011). A claimed node carries a lease the worker heartbeats while it
# produces; a dead/restarted worker stops, and after the TTL lapses the reaper returns the node to
# pending so the production resumes. Defaults: TTL 45min, heartbeat 60s, reaper 60s.
# CLAIM_LEASE_TTL_MS=2700000   # lease validity; must exceed heartbeat + the longest single produce (generous)
# CLAIM_HEARTBEAT_MS=60000     # how often a live worker extends the lease on nodes it holds
# REAPER_INTERVAL_MS=60000     # how often the worker sweeps for expired claims (also runs once at boot)

# Subagent engine. Code default: claude. Set fake for canned output, ZERO spend, no `claude` call.
SUBAGENT_ENGINE=fake
# SUBAGENT_MODEL=
# SUBAGENT_MAX_BUDGET_USD=     # per-call client-side spend cap (uncapped if empty)
# SUBAGENT_MAX_CALLS=          # process-lifetime cap on REAL subagent calls; worker parks idle once hit
# SUBAGENT_TIMEOUT_MS=         # per-call wall-clock budget; a runaway produce is aborted + retried/failed (uncapped if empty)
# SUBAGENT_WARN_MS=            # log subagent.slow when a completed call exceeds this (ms); off if empty
# CLAUDE_BIN=claude            # the `claude -p` binary
# AUTONOMY_CRAFT_ROOT=         # worker cwd: a dir with .claude/skills/ (the craft skills) + tools on PATH.
#                              # The node's skill resolves as /skill-name from here (spec 09). Unset = engine cwd.
# SUBAGENT_PERMISSION_MODE=bypassPermissions  # worker tool-permission mode; skills need tool use (Skill/Bash/Write)

# Render + voice engines (independent ports). Defaults: stub + silent (no video, no speech, zero cost).
# RENDER_PROVIDER=stub         # stub | local  (heygen|higgsfield reserved)
# RENDER_MOTION=1              # local: animatic motion (animated gradient bg + scene fades); static if unset
# RENDER_MAX_SCENES=6          # local: cap scenes so the video stays short
# RENDER_NARRATION_MAX=140     # local: clip each scene's spoken narration to this many chars
# VOICE_PROVIDER=silent        # silent | piper | kokoro
# VOICE_ID=                    # kokoro speaker id (e.g. af_sarah)
# VOICE_BIN=                   # override the TTS binary
# RENDER_FONT=                 # override the baked drawtext TTF
# VOICE_MODEL=                 # override the baked piper .onnx voice
# Keyed voice providers (vo.py --engine openai-tts | elevenlabs) — BYO-key, runtime-injected, NEVER
# baked; the provider tool reads the env var (or an --api-key-file the voice-production skill passes).
# openai-tts uses $OPENAI_API_KEY (set below, shared with codex + image-gen). elevenlabs:
# ELEVENLABS_API_KEY=          # ElevenLabs TTS (craft/video-production/tools/tts/elevenlabs.py); voice = rachel/adam/antoni/domi or a raw voice_id

# Image generation (the asset / moodboard lane — craft/video-production/tools/image.py). Default: stub (keyless SVG
# placeholder, zero cost), matching the render/voice stub defaults. Keyed providers are BYO-key, never
# baked: the adapter reads $OPENAI_API_KEY / $GEMINI_API_KEY (or an --api-key-file the skill passes).
# IMAGE_PROVIDER=stub          # stub | openai | gemini | custom
# IMAGE_MODEL=                 # override the provider default (openai: gpt-image-1; gemini: gemini-2.5-flash-image)
# IMAGE_SIZE=1024x1024         # requested size WxH (openai honours it; gemini ignores it — put aspect in the prompt)
# IMAGE_GEN_CMD=               # provider 'custom': a shell template, {prompt} {out} {model} {size} (local SD / Replicate / fal)

# Claude subscription auth (the engine image bundles the Claude Code CLI). Generate once on the host
# with `claude setup-token`, store in 1Password, inject here. NEVER set ANTHROPIC_API_KEY /
# ANTHROPIC_AUTH_TOKEN — either silently outranks the OAuth token and bills the API.
# CLAUDE_CODE_OAUTH_TOKEN=

# OpenAI Codex auth (the engine image bundles the Codex CLI for the `codex` SubagentRunner backend).
# codex in-container has no ChatGPT login, so it authenticates from OPENAI_API_KEY. Store in 1Password,
# inject here; never baked. Read when a node pins engine "codex" (TypeContract.engine) or
# SUBAGENT_ENGINE=codex. Shared with the openai image-gen provider above (IMAGE_PROVIDER=openai).
# OPENAI_API_KEY=

# Google Gemini auth (the engine image bundles the Gemini CLI for the `gemini` SubagentRunner backend).
# gemini in-container has no interactive Google login, so it authenticates from GEMINI_API_KEY. Store in
# 1Password, inject here; never baked. Read when a node pins engine "gemini" (TypeContract.engine) or
# SUBAGENT_ENGINE=gemini. Same key as the gemini image-gen provider above (IMAGE_PROVIDER=gemini).
# GEMINI_API_KEY=
#
# Gemini subagent engine is DISABLED by default: the current key 402s (RESOURCE_EXHAUSTED, prepaid
# credits depleted) though it is valid. Once a credited Gemini key is set above, re-enable the engine:
# SUBAGENT_GEMINI_ENABLED=1
