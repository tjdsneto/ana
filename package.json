{
	"name": "production-engine",
	"private": true,
	"type": "module",
	"description": "Autonomous video-production engine (PoC) — generic autonomy loop. No brand/product names (see CLAUDE.md).",
	"workspaces": [
		"server/shared",
		"server/services",
		"server/mcp",
		"server/engine",
		"dashboard/api",
		"dashboard/app"
	],
	"scripts": {
		"typecheck": "tsc -b && npm -w @app/dashboard-app run typecheck",
		"test": "vitest run",
		"db:migrate": "npm -w @app/shared run migrate",
		"db:seed": "npm -w @app/shared run seed",
		"dev:dashboard-api": "npm -w @app/dashboard-api run dev",
		"dev:dashboard-app": "npm -w @app/dashboard-app run dev"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
