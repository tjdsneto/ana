{
	"name": "ana",
	"private": true,
	"type": "module",
	"description": "AnA — autonomous-agent engine. Generic autonomy loop; runs typed task DAGs with a review/approval gate. No brand/product names in code (see CLAUDE.md).",
	"workspaces": [
		"shared",
		"core/services",
		"engine",
		"server/mcp",
		"server/api",
		"app"
	],
	"scripts": {
		"build": "tsc -b",
		"typecheck": "tsc -b && npm -w @app/web run typecheck",
		"test": "vitest run",
		"db:migrate": "npm -w @core/shared run migrate",
		"db:seed": "npm -w @core/shared run seed",
		"dev:api": "npm -w @server/api run dev",
		"dev:web": "npm -w @app/web run dev",
		"smoke": "node scripts/smoke/full-loop.mjs"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"packageManager": "npm@12.2.1",
	"devDependencies": {
		"@types/node": "^24.0.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
