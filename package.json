{
	"name": "production-engine",
	"private": true,
	"type": "module",
	"description": "Autonomous video-production engine (PoC) — generic autonomy loop. No brand/product names (see CLAUDE.md).",
	"workspaces": [
		"shared",
		"core/services",
		"engine",
		"server/mcp",
		"server/api",
		"app"
	],
	"scripts": {
		"typecheck": "tsc -b && npm -w @app/web run typecheck",
		"test": "vitest run",
		"db:migrate": "npm -w @core/shared run migrate",
		"db:seed": "npm -w @core/shared run seed",
		"dev:api": "npm -w @server/api run dev",
		"dev:web": "npm -w @app/web run dev"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
