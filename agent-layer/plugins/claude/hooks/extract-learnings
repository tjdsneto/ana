#!/usr/bin/env python3
"""Launch the agent-layer extract-learnings script from this plugin."""
from __future__ import annotations

import runpy
import sys
from pathlib import Path

HERE = Path(__file__).resolve()


def find_script() -> Path:
    in_repo = HERE.parents[3] / "scripts" / "extract-learnings"
    if in_repo.is_file():
        return in_repo
    pointer = HERE.with_name("script-path")
    if pointer.is_file():
        target = Path(pointer.read_text().strip())
        if target.is_file():
            return target
    raise SystemExit(f"extract-learnings not found from {HERE}")


script = find_script()
sys.argv[0] = str(script)
runpy.run_path(str(script), run_name="__main__")
