{
	"name": "@app/mcp",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "MCP server — the client-facing tool surface over the shared Store. HTTP (Compose) + a thin stdio entrypoint.",
	"scripts": {
		"build": "tsc -b",
		"start:stdio": "node dist/stdio.js",
		"start:http": "node dist/http.js",
		"dev:stdio": "tsx src/stdio.ts",
		"dev:http": "tsx src/http.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@app/shared": "*",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"express": "^4.21.2",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/express": "^4.17.21"
	}
}
