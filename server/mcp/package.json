{
	"name": "@server/mcp",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "MCP server — the client-facing transport over the @core/services layer. Pure wiring (zod schemas + registerTool). HTTP (Compose) + a thin stdio entrypoint.",
	"scripts": {
		"build": "tsc -b",
		"start:stdio": "node dist/stdio.js",
		"start:http": "node dist/http.js",
		"dev:stdio": "tsx src/stdio.ts",
		"dev:http": "tsx src/http.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@core/services": "*",
		"@core/shared": "*",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"express": "^5.3.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.6"
	}
}
