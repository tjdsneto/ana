# Copy to .env and fill. Real .env is gitignored. Keep render STUBBED until keys land.

# Logging (structured JSON lines to stderr via the Logger port). debug | info | warn | error.
LOG_LEVEL=info

# MCP server
MCP_HTTP_PORT=8787

# Postgres (the `db` Compose service)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@db:5432/app   # host `db` in Compose; use localhost:5432 for a local run

# Shared artifacts (files produced by the engine; big renders live here, not in the DB)
DATA_DIR=./server/data
ARTIFACTS_DIR=./server/data/artifacts

# Web app (dev/observability UI) — the SPA (app/) + its read API (server/api)
WEB_API_PORT=8788
WEB_PORT=5173

# Engine worker
POLL_INTERVAL_MS=3000
MAX_REDOS=3                    # rubric gate (produce-review): cap redos, then escalate (spec 02)
AGREEMENT_MAX_ROUNDS_HUMAN=5   # briefing agreement loop, actor_kind=human: rounds before escalate
AGREEMENT_MAX_ROUNDS_AGENT=2   # briefing agreement loop, actor_kind=agent/stubbed: lower cap, fast converge

# Subagent runner — which engine the loop dispatches to, and the model it uses.
SUBAGENT_ENGINE=fake           # claude | fake (codex | openai reserved, not implemented). fake = canned output, ZERO spend
# SUBAGENT_MODEL=              # default model for the engine (per-node override comes from the type registry later)
# SUBAGENT_MAX_BUDGET_USD=     # per-call client-side spend cap for the claude engine (uncapped if unset)
# SUBAGENT_MAX_CALLS=          # process-lifetime cap on REAL subagent calls: worker parks idle once hit
#                              # (restart to resume). Guards against draining stale queued work on a
#                              # retained volume. fake never counts. Set LOW for a real-claude smoke run.
CLAUDE_BIN=claude              # the `claude -p` binary, for the claude engine
# ENGINE_FAKE_SUBAGENT=1       # back-compat alias for SUBAGENT_ENGINE=fake

# Claude subscription auth for the claude engine (the engine image bundles the Claude Code CLI).
# Generate ONCE on your host: `claude setup-token` (browser flow, needs a Pro/Max/Team/Enterprise
# plan); the token lasts ~1 year, no refresh. Store it in 1Password and inject at launch — do NOT
# commit it or write it to a tracked file:
#   CLAUDE_CODE_OAUTH_TOKEN=$(op read "op://Private/claude-code/token") SUBAGENT_ENGINE=claude docker compose up engine-worker
# CLAUDE_CODE_OAUTH_TOKEN=
#
# WARNING: never set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN for the engine — either one silently
# OUTRANKS the OAuth token and bills the Console/API account instead of your subscription.

# Render engine (RenderClient port). stub = text placeholder, zero cost (default). local = a real
# .mp4 assembled offline with ffmpeg (slide cards from the storyboard + the voice track) — no key.
# heygen | higgsfield | hyperframes are reserved (keys pending Angie). The local assembler stays in
# the pipeline even once those land: external engines swap the per-scene VISUAL, ffmpeg still stitches.
# RENDER_PROVIDER=stub
# RENDER_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf   # local: TTF for drawtext captions
# RENDER_WIDTH=1280
# RENDER_HEIGHT=720

# Voice engine (VoiceClient port) — independent of the render engine, swapped on its own. silent = a
# silent track sized to the narration, no TTS binary (default). piper / kokoro = offline neural TTS
# (need the binary + a local voice model baked into the engine image; onnxruntime is glibc-shaped, so
# kokoro may require the debian engine base — see the Dockerfile note).
# VOICE_PROVIDER=silent        # silent | piper | kokoro
# VOICE_MODEL=/models/en_US-amy-medium.onnx   # piper: .onnx voice model
# VOICE_ID=af_sarah            # kokoro: speaker id
# VOICE_BIN=                   # override the TTS binary (default: piper / kokoro-tts)
