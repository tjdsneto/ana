# Copy to .env (gitignored). This file is ONLY host-side ${VAR} interpolation for docker-compose.yml
# (ports + Postgres creds). CONTAINER env — DATABASE_URL, ARTIFACTS_DIR, the engine knobs, the Claude
# token — lives in the per-service env files pulled via env_file: .common_env (all services) and
# .engine_env (the worker). Copy those from .common_env.example / .engine_env.example.

# Postgres (the `db` service) — creds for the db container; mirror them into DATABASE_URL in .common_env.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host ports (left side of the port mappings; the mcp/api containers also bind these).
MCP_HTTP_PORT=8787
WEB_API_PORT=8788
WEB_PORT=5173
# WEB_DEV_PORT=5173   # Vite dev server host port (dev profile)
