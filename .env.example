# Copy to .env and fill. Real .env is gitignored. Keep render STUBBED until keys land.

# Logging (structured JSON lines to stderr via the Logger port). debug | info | warn | error.
LOG_LEVEL=info

# MCP server
MCP_HTTP_PORT=8787

# Postgres (the `db` Compose service)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@db:5432/app   # host `db` in Compose; use localhost:5432 for a local run

# Shared artifacts (files produced by the engine; big renders live here, not in the DB)
DATA_DIR=./server/data
ARTIFACTS_DIR=./server/data/artifacts

# Web app (dev/observability UI) — the SPA (app/) + its read API (server/api)
WEB_API_PORT=8788
WEB_PORT=5173

# Engine worker
POLL_INTERVAL_MS=3000
MAX_REDOS=3                    # rubric gate (produce-review): cap redos, then escalate (spec 02)
AGREEMENT_MAX_ROUNDS_HUMAN=5   # briefing agreement loop, actor_kind=human: rounds before escalate
AGREEMENT_MAX_ROUNDS_AGENT=2   # briefing agreement loop, actor_kind=agent/stubbed: lower cap, fast converge

# Subagent runner — which engine the loop dispatches to, and the model it uses.
SUBAGENT_ENGINE=claude         # claude | fake (codex | openai reserved, not implemented). fake = canned output, no tokens
# SUBAGENT_MODEL=              # default model for the engine (per-node override comes from the type registry later)
CLAUDE_BIN=claude              # the `claude -p` binary, for the claude engine
# ENGINE_FAKE_SUBAGENT=1       # back-compat alias for SUBAGENT_ENGINE=fake (Compose sets this)

# Render engines (pending Angie — keep stubbed behind the render-client port until these land)
# RENDER_PROVIDER=stub
# RENDER_API_KEY=
